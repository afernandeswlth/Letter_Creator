# ─── Auth: Google sign-in (staff only) ─────────────────────────────────────
# Random 32+ char secret that seals the login session cookie:
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-plus-char-string
# Google OAuth client (Cloud Console → APIs & Services → Credentials → OAuth
# client ID, type "Web application"). Authorised redirect URI must be
#   https://YOUR-DOMAIN/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Only this email domain may sign in:
NUXT_ALLOWED_EMAIL_DOMAIN=wlth.com

# ─── Email drafts (Zapier) ──────────────────────────────────────────────────
# The Catch Hook URL from your Zap (Webhooks by Zapier → Catch Hook, then
# Gmail → Create Draft connected to hello@wlth.com):
ZAPIER_EMAIL_WEBHOOK_URL=

# Optional fallback instead of Zapier: a Gmail service account with domain-wide
# delegation (scope gmail.compose) impersonating the shared mailbox.
# GOOGLE_SERVICE_ACCOUNT_JSON={…service account key on one line…}
# GMAIL_SENDER=hello@wlth.com
