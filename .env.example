# ─── Email drafts (Zapier) ──────────────────────────────────────────────────
# The Catch Hook URL from your Zap (Webhooks by Zapier → Catch Hook, then
# Gmail → Create Draft connected to hello@wlth.com):
ZAPIER_EMAIL_WEBHOOK_URL=

# Commencement letters draft from a SEPARATE inbox (construction@wlth.com), so
# they use their own Zap: a second Catch Hook → Gmail Create Draft connected to
# construction@wlth.com. Map the fields it posts: to, cc, from, subject, body,
# filename, attachment (the PDF). Leave blank to fall back to the Gmail service
# account (below), if configured.
ZAPIER_CONSTRUCTION_WEBHOOK_URL=

# Optional fallback instead of Zapier: a Gmail service account with domain-wide
# delegation (scope gmail.compose) impersonating the shared mailbox.
# GOOGLE_SERVICE_ACCOUNT_JSON={…service account key on one line…}
# GMAIL_SENDER=hello@wlth.com

# ─── Letter history (Supabase) ──────────────────────────────────────────────
# Persists every generated letter (metadata + PDF) so the dashboard's Recent
# Letters works. Set these locally AND in Vercel's Environment Variables. The
# service_role key is a SECRET — server-side only, never exposed to the browser.
#   SUPABASE_URL: Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role secret
# Then run the SQL in docs/SUPABASE_SETUP.md and create a private 'letters' bucket.
SUPABASE_URL=https://obyugoznpdvclkbygyly.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional overrides (defaults shown):
# SUPABASE_LETTERS_TABLE=letters
# SUPABASE_LETTERS_BUCKET=letters

# ─── Add to Google Drive (folder picker) ────────────────────────────────────
# Powers the "Add to Google Drive" button on the download pages. These are
# PUBLIC client-side values (baked into the built app), NOT secrets. Set them
# locally AND in Vercel BEFORE the build (they're inlined at build time).
# See docs/GOOGLE_DRIVE_SETUP.md for how to create them.
#   CLIENT_ID: Google Cloud → APIs & Services → Credentials → OAuth 2.0 Web client
#   API_KEY:   same page → API key (restrict to the Picker API + your origins)
#   APP_ID:    the Cloud project NUMBER (optional; improves the Picker)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_GOOGLE_API_KEY=
NUXT_PUBLIC_GOOGLE_APP_ID=
