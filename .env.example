# ─── Email drafts (Zapier) ──────────────────────────────────────────────────
# The Catch Hook URL from your Zap (Webhooks by Zapier → Catch Hook, then
# Gmail → Create Draft connected to hello@wlth.com):
ZAPIER_EMAIL_WEBHOOK_URL=

# Commencement letters draft from a SEPARATE inbox (construction@wlth.com), so
# they use their own Zap: a second Catch Hook → Gmail Create Draft connected to
# construction@wlth.com. Map the fields it posts: to, cc, from, subject, body,
# filename, attachment (the PDF). Leave blank to fall back to the Gmail service
# account (below), if configured.
ZAPIER_CONSTRUCTION_WEBHOOK_URL=

# Optional fallback instead of Zapier: a Gmail service account with domain-wide
# delegation (scope gmail.compose) impersonating the shared mailbox.
# GOOGLE_SERVICE_ACCOUNT_JSON={…service account key on one line…}
# GMAIL_SENDER=hello@wlth.com
